{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miracle RenPy Launcher",
  "version": "0.1.2",
  "identifier": "com.theblackcat47.miraclerenpylauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Miracle Ren'Py Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "additionalBrowserArgs": "--disable-gpu",
        "dataDirectory": "webview-no-gpu"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
